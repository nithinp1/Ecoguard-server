# ==============================================================================
# Echoguard Server - Environment Configuration Template
# Copy this file to .env and fill in any required keys:
#   cp .env.example .env
# ==============================================================================

# Speech-to-Text (STT) Provider: whisper, nemotron, or sarvam
STT_PROVIDER=whisper

# Whisper STT Settings (Local GPU / CPU)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=auto

# Sarvam AI API Configuration (Required only if STT_PROVIDER=sarvam)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v4
SARVAM_MODE=transcribe
SARVAM_LANGUAGE=auto

# NVIDIA NeMo / Parakeet Configuration (Optional local ASR)
NVIDIA_API_KEY=
NVIDIA_ASR_ENDPOINT=http://host.docker.internal:9000/v1/audio/transcriptions
NVIDIA_ASR_MODEL=nvidia/parakeet-ctc-0.6b

# Ollama LLM Configuration (Connects from Docker container to host Ollama)
OLLAMA_HOST=host.docker.internal
OLLAMA_MODEL=phi3.5

# Detection Mode: all (LLM + XGBoost + Rule-Based), llm_only, xgboost_only, rulebased_only
DETECTION_MODE=all

# Call Timeouts (seconds)
CALL_INACTIVITY_TIMEOUT=20.0
INITIAL_AUDIO_WAIT_TIMEOUT=120.0

# Persistent Data Storage Directory
DATA_DIR=/app/data

